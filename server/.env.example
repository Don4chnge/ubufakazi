# Copy to .env (python -m ubufakazi_server.setup does this for you with random secrets).
# NEVER commit .env. All values below are placeholders.

# Random 32+ byte secrets (setup generates them)
UBF_SECRET_KEY=change-me
UBF_HMAC_KEY=change-me

# Database: SQLite for the local demo. For Postgres/Supabase use e.g.
# postgresql+psycopg://user:password@host:5432/ubufakazi
DATABASE_URL=sqlite:///./data/ubufakazi.db

# Private evidence storage directory (never inside site/)
UBF_STORAGE_DIR=./data/evidence

# Public URL of this server (used in Telegram messages for the "track my report" link). Optional.
UBF_PUBLIC_BASE_URL=http://localhost:8000

# Set to 1 when served over HTTPS so cookies get the Secure flag
UBF_COOKIE_SECURE=0

# Telegram bot token from @BotFather (optional: the bot does not start without it)
TELEGRAM_BOT_TOKEN=

# Optional AI provider for reading images, PDFs, audio and video (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
